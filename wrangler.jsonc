{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formulario-capacitacao-dvs",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formulario-capacitacao-dvs",
      "database_id": "5829c18a-6a8a-43c3-9875-432a82516c0c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
